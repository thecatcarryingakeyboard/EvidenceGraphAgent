# Safe local defaults: no API key is needed for the offline demo.
APP_ENV=development
LLM_PROVIDER=demo

# OpenAI-compatible provider (DeepSeek, Ollama, vLLM, OpenAI, etc.)
# LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

MAX_CONTEXT_CHARS=12000
MAX_RETRIEVAL_K=6
ENABLE_TRACE=true
ALLOW_CROSS_TENANT=false
